PROJECT_NAME="Agry-Key Backend"
API_V1_STR="/api/v1"
# Generate a unique cryptographic secret (min 32 chars) for local/deployed environments. Do not commit .env.
SECRET_KEY="replace-with-a-random-secret-at-least-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local dev; PostgreSQL for production)
DATABASE_URL="sqlite:///./agry_key.db"

# CORS Origins (Comma separated or * for all)
CORS_ORIGINS="*"

# External API Keys
WEATHER_API_KEY="sample_weather_key"
GEMINI_API_KEY="sample_gemini_key"

# SMS OTP Provider Configuration (msg91, twilio, or mock)
SMS_PROVIDER="msg91"
SMS_API_KEY=""
SMS_OTP_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Hugging Face Spaces Deep Learning Price Forecasting Microservice
HUGGINGFACE_API_KEY="sample_hf_key"
DL_FORECAST_SERVICE_URL="https://agry-key-dl-space.hf.space/api/predict"
DL_FORECAST_SERVICE_TOKEN="replace-with-a-secure-service-token"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=""

