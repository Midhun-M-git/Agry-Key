PROJECT_NAME="Agry-Key Backend"
API_V1_STR="/api/v1"
# Generate a unique value for local/deployed environments. Do not commit .env.
SECRET_KEY="replace-with-a-random-secret-at-least-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration (SQLite default for local dev)
DATABASE_URL="sqlite:///./agry_key.db"

# CORS Origins (Comma separated or * for all)
CORS_ORIGINS="*"

# External API Keys
WEATHER_API_KEY="sample_weather_key"
GEMINI_API_KEY="sample_gemini_key"

# Hugging Face and forecasting service configuration
HUGGINGFACE_API_KEY="sample_hf_key"
DL_FORECAST_SERVICE_URL="https://agry-key-dl-space.hf.space/api/predict"
DL_FORECAST_SERVICE_TOKEN="replace-with-a-service-token"
